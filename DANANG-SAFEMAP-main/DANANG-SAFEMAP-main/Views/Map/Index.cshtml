@{
    ViewData["Title"] = "Bản đồ An ninh";
}

<!-- ═══ Leaflet CSS ═══ -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css" />
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css" />
<link rel="stylesheet" href="~/css/map.css" asp-append-version="true" />

<!-- ═══ MAP CONTAINER ═══ -->
<div class="map-wrapper">
    <!-- Bản đồ -->
    <div id="map"></div>

    <!-- Nút báo cáo -->
    <button id="btn-report" class="map-fab" title="Báo cáo sự cố">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
    </button>

    <!-- Nút định vị -->
    <button id="btn-locate" class="map-fab map-fab--locate" title="Vị trí của tôi">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="3"></circle>
            <path d="M12 2v4M12 18v4M2 12h4M18 12h4"></path>
        </svg>
    </button>

    <!-- Nút hướng dẫn -->
    <button id="btn-guide" class="map-fab map-fab--guide" title="Hướng dẫn sử dụng">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
            <line x1="12" y1="17" x2="12.01" y2="17"/>
        </svg>
    </button>

    <!-- Nút báo cáo của tôi -->
    <a href="/Map/MyReports" id="btn-my-reports" class="map-fab map-fab--my" title="Báo cáo của tôi">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="16" y1="13" x2="8" y2="13"/>
            <line x1="16" y1="17" x2="8" y2="17"/>
        </svg>
    </a>

    <!-- Bộ lọc loại sự cố -->
    <div id="filter-panel" class="map-filter-panel">
        <div class="filter-title">Bộ lọc</div>
        <div id="filter-types" class="filter-types"></div>
    </div>

    <!-- Time-slider -->
    <div id="time-slider-panel" class="time-slider-panel">
        <div class="slider-label-row">
            <span class="slider-current-label" id="sliderLabel">24 giờ qua</span>
        </div>
        <input type="range" id="timeSlider" min="0" max="3" value="0" step="1" />
        <div class="slider-labels">
            <span>24h</span>
            <span>48h</span>
            <span>7 ngày</span>
            <span>30 ngày</span>
        </div>
    </div>

    <!-- ═══ GUIDE MODAL ═══ -->
    <div id="guide-modal" class="guide-modal" style="display:none">
        <div class="guide-modal__box">
            <div class="guide-modal__header">
                <h3>📖 Hướng dẫn sử dụng bản đồ</h3>
                <button onclick="document.getElementById('guide-modal').style.display='none'" class="guide-close">&times;</button>
            </div>
            <div class="guide-steps">
                <div class="guide-step">
                    <div class="step-icon" style="background:#DBEAFE;color:#2563EB">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
                        </svg>
                    </div>
                    <div>
                        <b>Xem bản đồ theo zoom</b>
                        <p>Zoom ra (mức 10-12) → xem <b>Heatmap</b> vùng nguy hiểm. Zoom vừa (13-15) → xem <b>Cụm sự cố</b>. Zoom vào (16+) → xem <b>Marker chi tiết</b>.</p>
                    </div>
                </div>
                <div class="guide-step">
                    <div class="step-icon" style="background:#D1FAE5;color:#059669">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                            <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                        </svg>
                    </div>
                    <div>
                        <b>Đọc thông tin marker</b>
                        <p>Click vào bất kỳ marker nào để xem chi tiết: loại sự cố, thời gian, mô tả, ảnh, và số lần cộng đồng xác nhận.</p>
                    </div>
                </div>
                <div class="guide-step">
                    <div class="step-icon" style="background:#FEF3C7;color:#D97706">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="20" height="20">
                            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                        </svg>
                    </div>
                    <div>
                        <b>Báo cáo sự cố mới</b>
                        <p>Nhấn nút <b>+</b> góc phải → Click bản đồ ghim vị trí → Chọn loại sự cố → Nhập mô tả → Gửi. Báo cáo sẽ chờ Admin duyệt.</p>
                    </div>
                </div>
                <div class="guide-step">
                    <div class="step-icon" style="background:#F3E8FF;color:#7C3AED">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                            <polyline points="14 2 14 8 20 8"/>
                        </svg>
                    </div>
                    <div>
                        <b>Theo dõi báo cáo của bạn</b>
                        <p>Nhấn nút <b>📄</b> bên phải để xem trạng thái các báo cáo bạn đã đóng góp, số xác nhận từ cộng đồng.</p>
                    </div>
                </div>
                <div class="guide-step">
                    <div class="step-icon" style="background:#FEE2E2;color:#DC2626">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                            <polyline points="20 6 9 17 4 12"/>
                        </svg>
                    </div>
                    <div>
                        <b>Xác nhận sự cố cộng đồng</b>
                        <p>Click marker → nhấn "👍 Tôi cũng ghi nhận" nếu đúng, hoặc "👎 Không ghi nhận" nếu sai. ≥3 xác nhận → marker sáng hơn.</p>
                    </div>
                </div>
                <div class="guide-step">
                    <div class="step-icon" style="background:#E0F2FE;color:#0284C7">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                            <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
                            <rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
                        </svg>
                    </div>
                    <div>
                        <b>Lọc và thanh thời gian</b>
                        <p>Dùng bộ lọc trái để chọn loại sự cố. Kéo thanh trượt ở đáy để lọc theo khoảng thời gian (24h đến 30 ngày).</p>
                    </div>
                </div>
            </div>
            <button class="guide-got-it" onclick="document.getElementById('guide-modal').style.display='none'">
                Đã hiểu, bắt đầu dùng!
            </button>
        </div>
    </div>

    <!-- ═══ SIDEBAR BÁO CÁO ═══ -->
    <div id="sidebar-report" class="report-sidebar">
        <div class="report-sidebar__header">
            <h3>📝 Báo cáo sự cố</h3>
            <button id="btn-close-report" class="report-sidebar__close" title="Đóng">&times;</button>
        </div>

        <form id="reportForm" class="report-form" enctype="multipart/form-data">
            <!-- Loại sự cố -->
            <div class="form-group">
                <label for="alertType">Loại sự cố <span class="req">*</span></label>
                <select id="alertType" name="AlertTypeId" required>
                    <option value="">— Chọn loại sự cố —</option>
                </select>
            </div>

            <!-- Vị trí -->
            <div class="form-group">
                <label>Vị trí <span class="req">*</span></label>
                <div id="pinStatus" class="pin-status pin-status--empty">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                        <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                    <span>Click vào bản đồ để ghim vị trí</span>
                </div>
                <input type="hidden" id="lat" name="Latitude" />
                <input type="hidden" id="lng" name="Longitude" />
            </div>

            <!-- Địa chỉ -->
            <div class="form-group">
                <label for="addressText">Địa chỉ (tùy chọn)</label>
                <input type="text" id="addressText" name="AddressText" placeholder="VD: 123 Trần Phú, Q. Hải Châu" maxlength="500" />
            </div>

            <!-- Tiêu đề -->
            <div class="form-group">
                <label for="title">Tiêu đề <span class="req">*</span></label>
                <input type="text" id="title" name="Title" placeholder="Mô tả ngắn gọn sự cố" required maxlength="200" />
            </div>

            <!-- Mô tả -->
            <div class="form-group">
                <label for="description">Mô tả chi tiết <span class="req">*</span></label>
                <textarea id="description" name="Description" rows="4"
                          placeholder="Mô tả chi tiết sự cố (đối tượng, biển số xe, đặc điểm...)" required minlength="20"></textarea>
                <div class="char-count"><span id="charCount">0</span>/20 ký tự tối thiểu</div>
            </div>

            <!-- Thời gian -->
            <div class="form-group">
                <label for="incidentTime">Thời gian xảy ra <span class="req">*</span></label>
                <input type="datetime-local" id="incidentTime" name="IncidentTime" required />
            </div>

            <!-- Upload ảnh -->
            <div class="form-group">
                <label>Ảnh / Video (tùy chọn)</label>
                <div class="upload-zone" id="uploadZone">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="32" height="32">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="17 8 12 3 7 8"></polyline>
                        <line x1="12" y1="3" x2="12" y2="15"></line>
                    </svg>
                    <span>Nhấn để chọn hoặc kéo thả file</span>
                    <input type="file" id="mediaFiles" name="mediaFiles" accept="image/*,video/mp4" multiple hidden />
                </div>
                <div id="previewContainer" class="preview-container"></div>
            </div>

            <!-- Xác nhận -->
            <div class="form-group form-group--checkbox">
                <label>
                    <input type="checkbox" id="userConfirmed" name="UserConfirmed" value="true" />
                    <span>Tôi xác nhận thông tin trên là chính xác và chịu trách nhiệm về nội dung</span>
                </label>
            </div>

            <!-- Submit -->
            <button type="submit" id="submitBtn" class="btn-submit" disabled>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                    <line x1="22" y1="2" x2="11" y2="13"></line>
                    <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                </svg>
                Gửi báo cáo
            </button>
        </form>
    </div>

    <!-- ═══ THÔNG BÁO GHIM ═══ -->
    <div id="pin-mode-banner" class="pin-mode-banner" style="display:none;">
        📍 Click vào bản đồ để chọn vị trí sự cố — <button id="cancelPin" class="cancel-pin-btn">Hủy</button>
    </div>
</div>

@section Scripts {
    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script src="https://unpkg.com/leaflet.heat@0.2.0/dist/leaflet-heat.js"></script>
    <script src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"></script>

    <!-- Custom JS -->
    <script src="~/js/map-data.js" asp-append-version="true"></script>
    <script src="~/js/map-report.js" asp-append-version="true"></script>
    <script src="~/js/map-core.js" asp-append-version="true"></script>
}
