@{
    ViewData["Title"] = "Duyệt Báo Cáo Sự Cố";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-alerts-page">
    <!-- Header -->
    <div class="page-header">
        <div>
            <h4 class="fw-bold mb-1">Duyệt Báo Cáo Sự Cố</h4>
            <p class="text-muted mb-0">Kiểm tra và phê duyệt các báo cáo từ cộng đồng</p>
        </div>
        <div class="header-actions">
            <button class="btn-tab active" data-status="PENDING_REVIEW" onclick="switchTab(this)">
                ⏳ Chờ duyệt
                <span class="badge-count" id="pendingCount">...</span>
            </button>
            <button class="btn-tab" data-status="" onclick="switchTab(this)">
                📋 Tất cả
            </button>
            <button class="btn-tab" data-status="VISIBLE_UNVERIFIED" onclick="switchTab(this)">
                ✅ Đã duyệt
            </button>
            <button class="btn-tab" data-status="REJECTED" onclick="switchTab(this)">
                ❌ Từ chối
            </button>
        </div>
    </div>

    <!-- Alert list -->
    <div id="alertsList" class="alerts-grid">
        <div class="loading-state">
            <div class="spinner"></div>
            <span>Đang tải...</span>
        </div>
    </div>

    <!-- Phân trang -->
    <div id="pagination" class="pagination-bar" style="display:none"></div>
</div>

<!-- Modal từ chối -->
<div id="rejectModal" class="modal-overlay" style="display:none">
    <div class="modal-box">
        <h5>Từ chối báo cáo</h5>
        <p class="text-muted">Nhập lý do từ chối để người dùng hiểu rõ.</p>
        <textarea id="rejectReason" rows="3" placeholder="VD: Nội dung không đủ thông tin, không có bằng chứng..."></textarea>
        <div class="modal-actions">
            <button onclick="closeRejectModal()" class="btn-cancel">Hủy</button>
            <button onclick="confirmReject()" class="btn-confirm-reject">Xác nhận từ chối</button>
        </div>
    </div>
</div>

<style>
:root {
    --primary: #10B981;
    --danger: #EF4444;
    --warning: #F59E0B;
}

.admin-alerts-page { padding: 0 8px; }

.page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
    flex-wrap: wrap;
    gap: 12px;
}

.header-actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
}

.btn-tab {
    padding: 8px 16px;
    border-radius: 8px;
    border: 1px solid #e2e8f0;
    background: #fff;
    color: #64748b;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    gap: 6px;
}

.btn-tab.active {
    background: var(--primary);
    color: #fff;
    border-color: var(--primary);
}

.badge-count {
    background: rgba(255,255,255,0.3);
    padding: 1px 7px;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 700;
}

.btn-tab:not(.active) .badge-count {
    background: #ef4444;
    color: #fff;
}

.alerts-grid {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.alert-card {
    background: #fff;
    border-radius: 14px;
    border: 1px solid #e2e8f0;
    padding: 20px;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 16px;
    align-items: start;
    transition: box-shadow 0.2s;
}

.alert-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.08); }

.alert-card__badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 10px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 600;
    margin-bottom: 6px;
}

.badge-pending { background: #FEF3C7; color: #92400E; }
.badge-approved { background: #D1FAE5; color: #065F46; }
.badge-rejected { background: #FEE2E2; color: #991B1B; }
.badge-verified { background: #DBEAFE; color: #1E40AF; }

.alert-card__title {
    font-size: 15px;
    font-weight: 700;
    color: #1E293B;
    margin: 0 0 4px;
}

.alert-card__meta {
    font-size: 12px;
    color: #64748B;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 8px;
}

.alert-card__desc {
    font-size: 13px;
    color: #475569;
    line-height: 1.6;
    max-height: 60px;
    overflow: hidden;
}

.alert-card__media {
    display: flex;
    gap: 6px;
    margin-top: 10px;
}

.alert-card__media img {
    width: 60px;
    height: 60px;
    border-radius: 8px;
    object-fit: cover;
    border: 1px solid #e2e8f0;
    cursor: pointer;
}

.alert-card__actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 120px;
}

.btn-approve {
    padding: 8px 16px;
    border-radius: 8px;
    border: none;
    background: var(--primary);
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    white-space: nowrap;
}

.btn-approve:hover { background: #059669; transform: translateY(-1px); }

.btn-reject {
    padding: 8px 16px;
    border-radius: 8px;
    border: 1px solid #e2e8f0;
    background: #fff;
    color: var(--danger);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    white-space: nowrap;
}

.btn-reject:hover { background: #FEE2E2; border-color: var(--danger); }

.btn-view-map {
    padding: 6px 16px;
    border-radius: 8px;
    border: 1px solid #e2e8f0;
    background: #f8fafc;
    color: #64748b;
    font-size: 12px;
    cursor: pointer;
    text-decoration: none;
    text-align: center;
    display: block;
    transition: all 0.2s;
}

.btn-view-map:hover { background: #f1f5f9; }

.loading-state {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 60px;
    color: #64748b;
}

.spinner {
    width: 24px; height: 24px;
    border: 3px solid #e2e8f0;
    border-top-color: var(--primary);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
}

@@keyframes spin { to { transform: rotate(360deg); } }

.empty-state {
    text-align: center;
    padding: 60px 20px;
    color: #94a3b8;
}

.empty-state svg { margin-bottom: 12px; opacity: 0.4; }

.pagination-bar {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 24px;
}

.page-btn {
    width: 36px; height: 36px;
    border-radius: 8px;
    border: 1px solid #e2e8f0;
    background: #fff;
    color: #475569;
    font-size: 14px;
    cursor: pointer;
    transition: all 0.2s;
}

.page-btn.active, .page-btn:hover {
    background: var(--primary);
    color: #fff;
    border-color: var(--primary);
}

/* Modal */
.modal-overlay {
    position: fixed; inset: 0;
    background: rgba(0,0,0,0.5);
    z-index: 2000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
}

.modal-box {
    background: #fff;
    border-radius: 16px;
    padding: 28px;
    width: 100%;
    max-width: 440px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.2);
}

.modal-box h5 { margin: 0 0 8px; font-size: 18px; }

.modal-box textarea {
    width: 100%;
    padding: 12px;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    font-family: inherit;
    font-size: 14px;
    resize: vertical;
    margin-top: 12px;
    outline: none;
    box-sizing: border-box;
}

.modal-box textarea:focus { border-color: var(--primary); }

.modal-actions {
    display: flex;
    gap: 10px;
    margin-top: 16px;
    justify-content: flex-end;
}

.btn-cancel {
    padding: 10px 20px;
    border-radius: 8px;
    border: 1px solid #e2e8f0;
    background: #fff;
    color: #64748b;
    font-size: 14px;
    cursor: pointer;
}

.btn-confirm-reject {
    padding: 10px 20px;
    border-radius: 8px;
    border: none;
    background: var(--danger);
    color: #fff;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
}
</style>

<script>
    const API = '/api/alerts';
    const token = localStorage.getItem('token');
    const authHeader = { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' };

    let currentStatus = 'PENDING_REVIEW';
    let currentPage = 1;
    let pendingRejectId = null;
    const PAGE_SIZE = 15;

    async function loadAlerts(status, page = 1) {
        currentStatus = status;
        currentPage = page;

        document.getElementById('alertsList').innerHTML = `
            <div class="loading-state">
                <div class="spinner"></div><span>Đang tải...</span>
            </div>`;

        try {
            let url;
            if (status === 'PENDING_REVIEW') {
                url = `${API}/admin/pending`;
            } else {
                const params = new URLSearchParams({ page, pageSize: PAGE_SIZE });
                if (status) params.set('status', status);
                url = `${API}/admin/all?${params}`;
            }

            const res = await fetch(url, { headers: authHeader });
            const data = await res.json();

            // Handle both array (pending) and paginated object
            const items = Array.isArray(data) ? data : data.items;
            const total = Array.isArray(data) ? data.length : data.total;

            // Update pending count badge
            if (status === 'PENDING_REVIEW') {
                document.getElementById('pendingCount').textContent = total;
            }

            renderAlerts(items, status, total, page);
        } catch (e) {
            document.getElementById('alertsList').innerHTML =
                `<div class="empty-state"><p>❌ Không thể tải dữ liệu</p></div>`;
        }
    }

    function renderAlerts(items, status, total, page) {
        const container = document.getElementById('alertsList');

        if (!items || items.length === 0) {
            container.innerHTML = `
                <div class="empty-state">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/>
                    </svg>
                    <p>Không có báo cáo nào</p>
                </div>`;
            document.getElementById('pagination').style.display = 'none';
            return;
        }

        const statusMap = {
            'PENDING_REVIEW': ['badge-pending', '⏳ Chờ duyệt'],
            'VISIBLE_UNVERIFIED': ['badge-approved', '✅ Đã duyệt'],
            'VISIBLE_VERIFIED': ['badge-verified', '🔵 Đã xác thực'],
            'REJECTED': ['badge-rejected', '❌ Từ chối'],
            'EXPIRED': ['badge-rejected', '⏱ Hết hạn']
        };

        container.innerHTML = items.map(a => {
            const [badgeClass, badgeText] = statusMap[a.status] || ['badge-pending', a.status];
            const mediaHtml = a.mediaUrls?.slice(0, 3).map(url =>
                `<img src="${url}" onclick="window.open('${url}','_blank')" alt="media" />`
            ).join('') || '';

            const isPending = a.status === 'PENDING_REVIEW';
            const actionBtns = isPending ? `
                <button class="btn-approve" onclick="approveAlert(${a.id})">✅ Duyệt</button>
                <button class="btn-reject" onclick="openRejectModal(${a.id})">❌ Từ chối</button>
            ` : `<span style="font-size:12px;color:#94a3b8">Đã xử lý</span>`;

            const timeStr = new Date(a.incidentTime).toLocaleString('vi-VN');
            return `
                <div class="alert-card" id="card-${a.id}">
                    <div>
                        <span class="alert-card__badge ${badgeClass}">${badgeText}</span>
                        <span style="margin-left:8px;font-size:12px;background:#f1f5f9;padding:2px 8px;border-radius:10px;color:#475569">
                            ${a.iconEmoji || ''} ${a.alertTypeName}
                        </span>
                        <h5 class="alert-card__title">${escHtml(a.title)}</h5>
                        <div class="alert-card__meta">
                            <span>📍 ${escHtml(a.addressText || '(chưa có địa chỉ)')}</span>
                            <span>🕐 ${timeStr}</span>
                            <span>👤 ${escHtml(a.userName)}</span>
                            <span>👍 ${a.confirmCount}  👎 ${a.denyCount}</span>
                        </div>
                        <div class="alert-card__desc">${escHtml(a.description)}</div>
                        ${mediaHtml ? `<div class="alert-card__media">${mediaHtml}</div>` : ''}
                    </div>
                    <div class="alert-card__actions">
                        ${actionBtns}
                        <a class="btn-view-map" href="/Map" target="_blank">🗺 Xem bản đồ</a>
                    </div>
                </div>
            `;
        }).join('');

        // Pagination (chỉ hiện khi không phải pending tab)
        if (status !== 'PENDING_REVIEW' && total > PAGE_SIZE) {
            const totalPages = Math.ceil(total / PAGE_SIZE);
            document.getElementById('pagination').style.display = 'flex';
            document.getElementById('pagination').innerHTML = Array.from({ length: totalPages }, (_, i) => i + 1)
                .map(p => `<button class="page-btn ${p === page ? 'active' : ''}" onclick="loadAlerts('${status || ''}', ${p})">${p}</button>`)
                .join('');
        } else {
            document.getElementById('pagination').style.display = 'none';
        }
    }

    async function approveAlert(id) {
        const card = document.getElementById(`card-${id}`);
        if (!card) return;

        const btn = card.querySelector('.btn-approve');
        btn.disabled = true;
        btn.textContent = 'Đang duyệt...';

        const res = await fetch(`${API}/admin/${id}/approve`, {
            method: 'POST',
            headers: authHeader
        });
        const data = await res.json();

        if (data.success) {
            card.style.opacity = '0.5';
            card.style.transition = 'opacity 0.4s';
            setTimeout(() => {
                card.remove();
                // Reload nếu hết item
                if (!document.querySelector('.alert-card')) loadAlerts(currentStatus, currentPage);
            }, 400);
            showNotif('✅ ' + data.message, 'success');
        } else {
            btn.disabled = false;
            btn.textContent = '✅ Duyệt';
            showNotif('❌ ' + data.message, 'error');
        }
    }

    let pendingRejectBtn = null;

    function openRejectModal(id) {
        pendingRejectId = id;
        document.getElementById('rejectReason').value = '';
        document.getElementById('rejectModal').style.display = 'flex';
        document.getElementById('rejectReason').focus();
    }

    function closeRejectModal() {
        pendingRejectId = null;
        document.getElementById('rejectModal').style.display = 'none';
    }

    async function confirmReject() {
        if (!pendingRejectId) return;
        const reason = document.getElementById('rejectReason').value.trim();
        if (!reason) {
            document.getElementById('rejectReason').style.border = '1px solid red';
            return;
        }

        const res = await fetch(`${API}/admin/${pendingRejectId}/reject`, {
            method: 'POST',
            headers: authHeader,
            body: JSON.stringify({ reason })
        });
        const data = await res.json();

        closeRejectModal();
        if (data.success) {
            const card = document.getElementById(`card-${pendingRejectId}`);
            if (card) {
                card.style.opacity = '0.5';
                setTimeout(() => {
                    card.remove();
                    if (!document.querySelector('.alert-card')) loadAlerts(currentStatus, currentPage);
                }, 400);
            }
            showNotif('ℹ️ ' + data.message, 'success');
        } else {
            showNotif('❌ ' + data.message, 'error');
        }
    }

    function switchTab(btn) {
        document.querySelectorAll('.btn-tab').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        loadAlerts(btn.dataset.status, 1);
    }

    function escHtml(str) {
        if (!str) return '';
        const d = document.createElement('div');
        d.textContent = str;
        return d.innerHTML;
    }

    function showNotif(msg, type) {
        const el = document.createElement('div');
        el.style.cssText = `
            position:fixed;bottom:24px;right:24px;z-index:9999;
            padding:12px 20px;border-radius:10px;font-size:14px;font-weight:600;
            background:${type === 'success' ? '#10B981' : '#EF4444'};color:#fff;
            box-shadow:0 4px 20px rgba(0,0,0,0.2);animation:slideInRight 0.3s ease;
        `;
        el.textContent = msg;
        document.body.appendChild(el);
        setTimeout(() => el.remove(), 3500);
    }

    document.getElementById('rejectModal').addEventListener('click', function(e) {
        if (e.target === this) closeRejectModal();
    });

    // Load initial
    loadAlerts('PENDING_REVIEW');
</script>
