@model DaNangSafeMap.Models.VerifyEmailViewModel
@{
    ViewData["Title"] = "Xác nhận Email";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow">
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <i class="bi bi-envelope-check" style="font-size: 3rem; color: #007bff;"></i>
                        <h3 class="mt-3">Xác nhận Email</h3>
                        <p class="text-muted">Mã xác nhận đã được gửi đến</p>
                        <p class="fw-bold">@Model.Email</p>
                    </div>

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="VerifyEmail" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Email" />

                        <div class="mb-4">
                            <label asp-for="Otp" class="form-label">Nhập mã xác nhận (6 số)</label>
                            <input asp-for="Otp" class="form-control form-control-lg text-center" maxlength="6"
                                pattern="[0-9]{6}" inputmode="numeric" placeholder="______" autocomplete="one-time-code"
                                style="letter-spacing: 10px; font-size: 24px;" />
                            <span asp-validation-for="Otp" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 mb-3">
                            <i class="bi bi-check-circle me-2"></i>Xác nhận
                        </button>
                    </form>

                    <hr />

                    <form asp-action="ResendOtp" method="post" class="text-center">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="email" value="@Model.Email" />
                        <p class="text-muted mb-2">Không nhận được mã?</p>
                        <button type="submit" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-repeat me-2"></i>Gửi lại mã
                        </button>
                    </form>

                    <div class="text-center mt-3">
                        <small class="text-muted">
                            <i class="bi bi-clock me-1"></i>Mã có hiệu lực trong 5 phút
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Auto-focus on OTP input
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelector('input[name="Otp"]').focus();
        });
    </script>
}
